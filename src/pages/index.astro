        </section>

        <aside class="sidebar">
          <section class="reader-picks">
            <h2>✦ แนะนำจากผู้อ่าน</h2>
            <p class="sidebar-note"></p>

            <ol data-reader-ranking>
              {rankedWorks.map((work, index) => (
                  <li data-rank-item data-slug={work.slug}>
                  <a class="rank-link" href={`/title/${work.slug}`}>
                    <span class="rank" data-rank-medal>
                      {index === 0 ? "🥇" : index === 1 ? "🥈" : "🥉"}
                    </span>

                    <img src={work.cover} alt={`ปกเรื่อง ${work.title}`} />

                    <div>
                      <h3>{work.title}</h3>
                      <p>
  ♥ ผู้อ่านแนะนำ{" "}
  <span
    data-sidebar-recommend-count
    data-slug={work.slug}
  >
    {recommendationMap.get(work.slug) ?? 0}
  </span>{" "}
  คน
</p>
                    </div>
                  </a>
                </li>
              ))}
