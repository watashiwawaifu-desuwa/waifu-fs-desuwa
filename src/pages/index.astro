    <footer id="about">
      <div class="shell footer-inner">
        <div>
          <a class="brand" href="/">Waifu-<span>FS</span></a>
          <p></p>
        </div>
        <p>© 2026 Waifu-FS</p>
      </div>
    </footer>
  </body>
</html>
<script>
  import { supabase } from "../lib/supabase";

  const slider = document.querySelector<HTMLElement>("[data-banner-slider]");

  if (slider) {
    const slides = Array.from(
      slider.querySelectorAll<HTMLElement>("[data-banner-slide]")
    );

    const dots = Array.from(
      slider.querySelectorAll<HTMLButtonElement>("[data-banner-dot]")
    );

    let currentIndex = 0;
    let timer: number | undefined;

    function showSlide(index: number) {
      if (slides.length === 0) return;

      currentIndex = (index + slides.length) % slides.length;

      slides.forEach((slide, slideIndex) => {
        slide.classList.toggle("active", slideIndex === currentIndex);
      });

      dots.forEach((dot, dotIndex) => {
        dot.classList.toggle("active", dotIndex === currentIndex);
      });
    }

    function startAutoSlide() {
      window.clearInterval(timer);

      if (slides.length <= 1) return;

      timer = window.setInterval(() => {
        showSlide(currentIndex + 1);
      }, 6000);
    }

    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => {
        showSlide(index);
        startAutoSlide();
      });
    });

    slider.addEventListener("mouseenter", () => {
      window.clearInterval(timer);
    });

    slider.addEventListener("mouseleave", () => {
      startAutoSlide();
    });

     showSlide(0);
    startAutoSlide();
  }

  async function refreshRecommendations() {
    const { data, error } = await supabase
      .from("works")
      .select("slug,recommendations");

    if (error) {
      console.error("ไม่สามารถโหลดคะแนนแนะนำได้:", error);
      return;
    }

    const liveRecommendationMap = new Map(
      (data ?? []).map((item) => [
        item.slug,
        Number(item.recommendations ?? 0),
      ])
    );

    document
      .querySelectorAll<HTMLElement>("[data-home-recommend-count]")
      .forEach((element) => {
        const slug = element.dataset.slug;

        if (!slug) return;

        element.textContent = String(
          liveRecommendationMap.get(slug) ?? 0
        );
      });

    document
      .querySelectorAll<HTMLElement>("[data-sidebar-recommend-count]")
      .forEach((element) => {
        const slug = element.dataset.slug;

        if (!slug) return;

        element.textContent = String(
          liveRecommendationMap.get(slug) ?? 0
        );
      });

    const rankingList =
      document.querySelector<HTMLOListElement>("[data-reader-ranking]");

    if (!rankingList) return;

    const rankingItems = Array.from(
      rankingList.querySelectorAll<HTMLElement>("[data-rank-item]")
    );

    rankingItems.sort((a, b) => {
      const countA =
        liveRecommendationMap.get(a.dataset.slug ?? "") ?? 0;

      const countB =
        liveRecommendationMap.get(b.dataset.slug ?? "") ?? 0;

      return countB - countA;
    });

    const medals = ["🥇", "🥈", "🥉"];

    rankingItems.forEach((item, index) => {
      const medal = item.querySelector<HTMLElement>(
        "[data-rank-medal]"
      );

      if (medal) {
        medal.textContent = medals[index] ?? String(index + 1);
      }

      rankingList.appendChild(item);
    });
  }

  refreshRecommendations();
</script>
