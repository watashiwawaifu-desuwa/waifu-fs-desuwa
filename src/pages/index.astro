</section>

      <div class="content-layout">
        <section class="main-column" id="latest">
          <div class="section-heading">
            <div>
              <p class="section-kicker">✦ นิยายแปล</p>
              <h2></h2>
            </div>
            <a href="#all-works">ดูทั้งหมด ›</a>
          </div>

          <div class="work-grid">
            {works.map((work) => (
              <a class="work-card" href={`/title/${work.slug}`}>
                <div class="cover-wrap">
                  <img src={work.cover} alt={`ปกเรื่อง ${work.title}`} loading="lazy" />
                  <span class="type-badge">{work.type}</span>
                  <span class:list={["status-badge", work.status === "จบแล้ว" && "finished"]}>
                    {work.status}
                  </span>
                  <span class="recommend-badge">
                    ♥ <strong
                      data-home-recommend-count
                      data-slug={work.slug}
                    >
                      {recommendationMap.get(work.slug) ?? 0}
                    </strong>
                  </span>
                </div>

                <div class="card-body">
                  <h3>{work.title}</h3>
                </div>
              </a>
            ))}
