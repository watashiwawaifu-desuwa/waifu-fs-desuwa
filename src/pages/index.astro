---
import { works } from "../data/works";
import { banners } from "../data/banners";
import { supabase } from "../lib/supabase";

const { data } = await supabase
  .from("works")
  .select("slug,recommendations");

const recommendationMap = new Map(
  (data ?? []).map((item) => [item.slug, item.recommendations])
);

const rankedWorks = [...works].sort((a, b) => {
  const countA = Number(recommendationMap.get(a.slug) ?? 0);
  const countB = Number(recommendationMap.get(b.slug) ?? 0);

  return countB - countA;
});

const activeBanners = banners
  .filter((banner) => banner.active)
  .map((banner) => {
    const work = works.find((item) => item.slug === banner.slug);

    return {
      ...banner,
      work,
    };
  })
  .filter((banner) => banner.work)
  .sort((a, b) => (a.priority ?? 0) - (b.priority ?? 0));
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="รวมผลงานและช่องทางอ่านของ Waifu-FS" />
    <title>Waifu-FS</title>
  </head>

  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/">Waifu-<span>FS</span></a>

        <nav>
          <a class="active" href="/">หน้าแรก</a>
        </nav>

        <div class="header-tools">
          <label class="search">
