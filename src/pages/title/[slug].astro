---
import { works } from "../../data/works";
import { platforms } from "../../data/platforms";
import RecommendButton from "../../components/RecommendButton.astro";

export function getStaticPaths() {
  return works.map((work) => ({
    params: { slug: work.slug },
    props: { work },
  }));
}

const { work } = Astro.props;

const workIllustrations =
  "illustrations" in work && Array.isArray(work.illustrations)
    ? work.illustrations
    : [];

const workPlatforms = work.platforms.map((item) => ({
  ...platforms[item.id as keyof typeof platforms],
  url: item.url,
}));
---

<!doctype html>
<html lang="th">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{work.title} | Waifu-FS</title>
  </head>

  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/">Waifu-<span>FS</span></a>

        <nav>
          <a href="/">หน้าแรก</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="story-hero">
        <div class="backdrop">
          <img src={work.cover} alt="" />
        </div>

        <div class="shell story-layout">
          <div class="cover-column">
            <img
              class="story-cover"
              src={work.cover}
              alt={`ปกเรื่อง ${work.title}`}
            />

            <RecommendButton slug={work.slug} />
          </div>
            
          <div class="story-info">
            <a class="back-link" href="/">‹ กลับหน้าแรก</a>

            <p class="eyebrow">{work.type}</p>

            <h1>{work.title}</h1>

            <div class="meta">
              <span>{work.status}</span>
            </div>
            <div class="tag-list">
  {
    work.tags.map((tag) => (
      <span class="tag">#{tag}</span>
    ))
  }
</div>
            <section class="description">
              <h2>เรื่องย่อ</h2>
              <p>{work.description}</p>
            </section>
{
  workIllustrations.length > 0 && (
    <section class="illustration-section">
      <h2>ภาพประกอบ</h2>

      <div class="illustration-grid">
  {
    workIllustrations.slice(0, 2).map((image, index) => (
      <button
        type="button"
        class="illustration-card"
        data-illustration-src={image}
        aria-label={`เปิดภาพประกอบ ${index + 1}`}
      >
        <img
          src={image}
          alt={`ภาพประกอบ ${index + 1} - ${work.title}`}
          loading="lazy"
        />
      </button>
    ))
  }

  {
    workIllustrations.length > 2 && (
      <button
  type="button"
  class="illustration-more"
  data-gallery-open
  aria-label={`ดูภาพประกอบอีก ${workIllustrations.length - 2} รูป`}
>
  <span>▣</span>
  <strong>+อีก {workIllustrations.length - 2} รูป</strong>
</button>
    )
  }
</div>
    </section>
  )
}
            <section class="reading-section">
              <h2>เลือกช่องทางอ่าน</h2>

              <div class="platform-grid">
  {
    workPlatforms.map((platform) => (
      <a
  href={platform.url}
  class="platform-button"
  style={`--platform-color: ${platform.color};`}
  target="_blank"
  rel="noopener noreferrer"
>
        <img
          src={platform.logo}
          alt={`โลโก้ ${platform.name}`}
        />

        <div class="platform-info">
          <strong>{platform.name}</strong>
          <span>อ่านบน {platform.name}</span>
        </div>

        <span class="platform-arrow">›</span>
      </a>
    ))
  }
</div>

          </section>
        </div>
      </div>
    </section>
    
  </main>

<dialog class="illustration-gallery-modal" data-illustration-gallery>
  <div class="gallery-modal-header">
    <h2>ภาพประกอบ</h2>

    <button
      type="button"
      class="gallery-modal-close"
      data-gallery-close
      aria-label="ปิดแกลเลอรี่"
    >
      ×
    </button>
  </div>

  <div class="gallery-modal-grid">
    {
      workIllustrations.map((image, index) => (
        <button
          type="button"
          class="gallery-modal-item"
          data-gallery-image={image}
          aria-label={`เปิดภาพประกอบ ${index + 1}`}
        >
          <img
            src={image}
            alt={`ภาพประกอบ ${index + 1} - ${work.title}`}
            loading="lazy"
          />
        </button>
      ))
    }
  </div>
</dialog>

<dialog class="illustration-lightbox" data-illustration-lightbox>
  <button
    type="button"
    class="lightbox-close"
    data-illustration-close
    aria-label="ปิดภาพ"
  >
    ×
  </button>

  <img data-illustration-full alt="ภาพประกอบขนาดใหญ่" />
</dialog>
</body>
</html>
<script>
  const gallery =
  document.querySelector<HTMLDialogElement>("[data-illustration-gallery]");

const galleryOpen =
  document.querySelector<HTMLButtonElement>("[data-gallery-open]");

const galleryClose =
  document.querySelector<HTMLButtonElement>("[data-gallery-close]");

const lightbox =
  document.querySelector<HTMLDialogElement>("[data-illustration-lightbox]");

const fullImage =
  document.querySelector<HTMLImageElement>("[data-illustration-full]");

const lightboxClose =
  document.querySelector<HTMLButtonElement>("[data-illustration-close]");

galleryOpen?.addEventListener("click", () => {
  gallery?.showModal();
});

galleryOpen?.addEventListener("click", () => {
  gallery?.showModal();
});

galleryClose?.addEventListener("click", () => {
  gallery?.close();
});

document
  .querySelectorAll<HTMLButtonElement>("[data-gallery-image]")
  .forEach((button) => {
    button.addEventListener("click", () => {
      const image = button.dataset.galleryImage;

      if (!image || !lightbox || !fullImage) return;


      fullImage.src = image;
      lightbox.showModal();
    });
  });

document
  .querySelectorAll<HTMLButtonElement>("[data-illustration-src]")
  .forEach((button) => {
    button.addEventListener("click", () => {
      const image = button.dataset.illustrationSrc;

      if (!image || !lightbox || !fullImage) return;

      fullImage.src = image;
      lightbox.showModal();
    });
  });

lightboxClose?.addEventListener("click", () => {
  lightbox?.close();
});

lightbox?.addEventListener("click", (event) => {
  if (event.target === lightbox) {
    lightbox.close();
  }
});
</script>
<style>
  :root {
    font-family:
      Inter, "Noto Sans Thai", system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;

    color: #f7f3f8;
    background: #090810;

    --bg: #090810;
    --surface: #15111b;
    --border: rgba(193, 143, 196, 0.18);
    --muted: #aaa2af;
    --pink: #d25b98;
    --pink-soft: #e183b5;
  }

  * {
    box-sizing: border-box;
  }

  body {
    min-width: 320px;
    margin: 0;
    background: #090810;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    font: inherit;
  }

  .shell {
    width: min(1380px, calc(100% - 40px));
    margin-inline: auto;
  }

  .site-header {
    position: relative;
    z-index: 20;
    border-bottom: 1px solid var(--border);
    background: rgba(9, 8, 16, 0.9);
    backdrop-filter: blur(18px);
  }

  .header-inner {
    min-height: 76px;
    display: flex;
    align-items: center;
    gap: 40px;
  }

  .brand {
    font-size: 1.65rem;
    font-weight: 900;
    letter-spacing: -0.055em;
  }

  .brand span {
    color: var(--pink);
  }

  nav {
    display: flex;
    gap: 30px;
    color: #bcb4c1;
  }

  nav a:hover {
    color: var(--pink-soft);
  }

  .story-hero {
    position: relative;
    min-height: calc(100vh - 76px);
    overflow: hidden;
  }

  .backdrop {
    position: absolute;
    inset: 0;
  }

  .backdrop::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(9, 8, 16, 0.98) 0%,
        rgba(9, 8, 16, 0.86) 42%,
        rgba(9, 8, 16, 0.55) 100%
      ),
      linear-gradient(
        0deg,
        rgba(9, 8, 16, 1) 0%,
        transparent 60%
      );
  }

  .backdrop img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(18px) brightness(0.42) saturate(0.85);
    transform: scale(1.1);
  }

  .story-layout {
    position: relative;
    z-index: 2;
    padding-top: 64px;
    padding-bottom: 80px;

    display: grid;
    grid-template-columns: 330px minmax(0, 1fr);
    gap: 64px;
    align-items: start;
  }

  .cover-column {
    position: sticky;
    top: 100px;
  }

  .story-cover {
    width: 100%;
    aspect-ratio: 2 / 3;
    display: block;
    border: 1px solid var(--border);
    border-radius: 18px;
    object-fit: cover;

    box-shadow:
      0 28px 80px rgba(0, 0, 0, 0.5),
      0 0 40px rgba(210, 91, 152, 0.12);
  }

  .recommend-box {
    margin-top: 18px;
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 16px;
    background: rgba(21, 17, 27, 0.86);
  }

  .recommend-box p {
    margin: 0 0 12px;
    color: var(--pink-soft);
    text-align: center;
  }

  .recommend-box button {
    width: 100%;
    border: 0;
    border-radius: 10px;
    padding: 13px;

    color: white;
    background: linear-gradient(135deg, #8d557f, #c14f8b);

    font-weight: 800;
    cursor: pointer;
  }

  .story-info {
    max-width: 850px;
    padding-top: 18px;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 36px;
    color: #a69daa;
  }

  .eyebrow {
    margin: 0 0 12px;
    color: var(--pink);
    font-weight: 850;
  }

  h1 {
    max-width: 900px;
    margin: 0 0 24px;

    font-size: clamp(2.5rem, 5vw, 5rem);
    line-height: 1.12;
    letter-spacing: -0.045em;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .meta span {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 8px 13px;

    color: #d7ceda;
    background: rgba(255, 255, 255, 0.035);
  }
    .tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin: 20px 0 28px;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 8px 14px;
  border-radius: 999px;

  border: 1px solid rgba(255,255,255,.08);
  background: rgba(255,255,255,.035);

  color: #d7d7d7;
  font-size: .88rem;
  font-weight: 500;

  cursor: pointer;

  transition:
    background .25s,
    border-color .25s,
    color .25s,
    transform .2s;
}

.tag:hover {
  transform: translateY(-2px);

  border-color: #d45b98;
  background: rgba(212,91,152,.12);

  color: #fff;
}
  .description,
.reading-section,
.illustration-section {
  margin-top: 50px;
}

.description h2,
.reading-section h2,
.illustration-section h2 {
  margin: 0 0 18px;
  font-size: 1.35rem;
}

  .description p {
    max-width: 760px;
    margin: 0;

    color: #b8afbc;
    font-size: 1.02rem;
    line-height: 1.9;
  }

  .platform-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14px;
  max-width: 760px;
}

  .platform-button {
  min-height: 92px;
  display: grid;
  grid-template-columns: 64px minmax(0, 1fr) 28px;
  align-items: center;
  gap: 14px;

  border: 1px solid
    color-mix(in srgb, var(--platform-color) 45%, transparent);
  border-radius: 14px;
  padding: 12px 16px;

  color: white;
  background:
    linear-gradient(
      135deg,
      color-mix(in srgb, var(--platform-color) 22%, #15111b),
      #15111b 70%
    );

  transition:
    transform 160ms ease,
    border-color 160ms ease,
    box-shadow 160ms ease;
}

.platform-button img {
  width: 64px;
  height: 64px;
  border-radius: 12px;
  object-fit: contain;
  background: rgba(255, 255, 255, 0.06);
}

.platform-info {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.platform-info strong {
  font-size: 1rem;
}

.platform-info span {
  color: #b9b0bd;
  font-size: 0.78rem;
  font-weight: 500;
}

.platform-arrow {
  color: var(--platform-color);
  font-size: 1.7rem;
  transition: transform 160ms ease;
}

.platform-button:hover {
  transform: translateY(-3px);
  border-color: var(--platform-color);
  box-shadow:
    0 14px 35px rgba(0, 0, 0, 0.32),
    0 0 22px color-mix(in srgb, var(--platform-color) 18%, transparent);
}

.platform-button:hover .platform-arrow {
  transform: translateX(5px);
}
.illustration-grid {
  max-width: 760px;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 14px;
}

.illustration-card {
  display: block;
  overflow: hidden;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 8px;
  background: #15111b;
  cursor: pointer;
}

.illustration-card img {
  width: 100%;
  height: auto;
  display: block;
  border-radius: 8px;
  transition: transform 180ms ease;
}

.illustration-card:hover img {
  transform: scale(1.035);
}

.illustration-more {
  min-height: 70px;
  border: 1px solid var(--border);
  border-radius: 12px;
  background: rgba(21, 17, 27, 0.88);
  color: #fff;
  cursor: pointer;

  display: flex;
  align-items: center;
  justify-content: center;
  gap: 7px;

  font-size: 15px;
  transition: background 180ms ease, border-color 180ms ease;
}

.illustration-more:hover {
  background: rgba(35, 25, 42, 0.95);
  border-color: #c0448c;
}

.illustration-more span {
  color: #e96caf;
  font-size: 18px;
}

.illustration-lightbox {
  width: 100vw;
  height: 100vh;
  max-width: none;
  max-height: none;
  margin: 0;
  padding: 0;
  border: 0;
  background: #000;
  overflow: hidden;
}

.illustration-lightbox::backdrop {
  background: rgba(0, 0, 0, 0.92);
  backdrop-filter: blur(5px);
}

.illustration-lightbox[open] {
  display: flex;
  align-items: center;
  justify-content: center;
}

.illustration-lightbox > img {
  display: block;
  width: auto;
  height: auto;
  max-width: calc(100vw - 80px);
  max-height: calc(100vh - 60px);
  object-fit: contain;
}

.lightbox-close {
  position: fixed;
  top: 22px;
  right: 28px;
  z-index: 20;

  width: 48px;
  height: 48px;

  display: grid;
  place-items: center;

  border: 0;
  border-radius: 50%;
  background: rgba(20, 20, 24, 0.75);
  color: white;

  font-size: 30px;
  line-height: 1;
  cursor: pointer;
}

.lightbox-close:hover {
  background: rgba(50, 50, 56, 0.95);
}

@media (max-width: 680px) {
  .illustration-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
  @media (max-width: 900px) {
    nav {
      display: none;
    }

    .story-layout {
      grid-template-columns: 260px minmax(0, 1fr);
      gap: 36px;
    }
  }

  @media (max-width: 680px) {
    .shell {
      width: min(100% - 24px, 1380px);
    }

    .story-layout {
      grid-template-columns: 1fr;
      padding-top: 30px;
    }

    .cover-column {
      position: static;
      max-width: 260px;
      margin-inline: auto;
    }

    .story-info {
      padding-top: 0;
    }

    h1 {
      font-size: 2.2rem;
    }

    .platform-grid {
      grid-template-columns: 1fr;
    }
  }
  .illustration-gallery-modal {
  width: min(1200px, calc(100% - 40px));
  max-height: 90vh;
  padding: 22px;
  border: 1px solid var(--border);
  border-radius: 18px;
  background: #15151b;
  color: white;
  overflow-y: auto;
}

.illustration-gallery-modal::backdrop {
  background: rgba(0, 0, 0, 0.82);
  backdrop-filter: blur(5px);
}

.gallery-modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20px;
}

.gallery-modal-header h2 {
  margin: 0;
  font-size: 24px;
}

.gallery-modal-close {
  width: 42px;
  height: 42px;
  border: 0;
  border-radius: 50%;
  background: #09090c;
  color: white;
  font-size: 26px;
  cursor: pointer;
}

.gallery-modal-grid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: 14px;
}

.gallery-modal-item {
  border: 0;
  padding: 0;
  background: transparent;
  border-radius: 10px;
  overflow: hidden;
  cursor: pointer;
}

.gallery-modal-item img {
  width: 100%;
  height: 270px;
  display: block;
  object-fit: cover;
  border-radius: 10px;
}

.gallery-modal-item:hover img {
  transform: scale(1.03);
}

.gallery-modal-item img {
  transition: transform 180ms ease;
}

@media (max-width: 700px) {
  .illustration-gallery-modal {
    width: calc(100% - 24px);
    max-height: 92vh;
    padding: 14px;
  }

  .gallery-modal-header h2 {
    font-size: 20px;
  }

  .gallery-modal-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }

  .gallery-modal-item img {
  height: 250px;
}

@media (max-width: 680px) {
  .illustration-lightbox > img {
    max-width: 100vw;
    max-height: 100vh;
  }

  .lightbox-close {
    top: 14px;
    right: 14px;
    width: 42px;
    height: 42px;
    font-size: 26px;
  }
}

</style>